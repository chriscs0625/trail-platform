# .env.example
# Copy this file to .env or .env.local and replace the values with your own.

# Database URL (SQLite usually local.db in Prisma)
DATABASE_URL="file:./local.db"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-super-secret-key-for-better-auth" # Generate one with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000" # Should match your frontend URL

# Next Auth (if applicable / needed by older plugins)
NEXTAUTH_URL="http://localhost:3000"
